<Window x:Class="Watchout.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WATCHOUT 7 — Producer"
        Width="1600" Height="980" MinWidth="1100" MinHeight="720"
        Background="#111111" Foreground="#E8E6E3"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#1A1A1A" Foreground="#E8E6E3">
      <MenuItem Header="_File">
        <MenuItem Header="_New Show" InputGestureText="Ctrl+Shift+N" Click="NewShow_Click"/>
        <MenuItem Header="Demo Show" Click="Demo_Click"/>
        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click"/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
        <Separator/>
        <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click"/>
        <MenuItem Header="Du_plicate" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
      </MenuItem>
      <MenuItem Header="_Stage">
        <MenuItem Header="Fit to _Display" Click="FitDisplay_Click"/>
        <MenuItem Header="Fit to _Wall" Click="FitWall_Click"/>
        <MenuItem Header="Frame Displays" Click="Frame_Click"/>
        <MenuItem Header="Add Display" Click="AddDisplay_Click"/>
        <MenuItem Header="Display Grid 3×1" Click="Grid31_Click"/>
        <MenuItem Header="Display Grid 2×2" Click="Grid22_Click"/>
        <MenuItem Header="Display Grid 4×1" Click="Grid41_Click"/>
      </MenuItem>
      <MenuItem Header="_Timeline">
        <MenuItem Header="Play / Pause" InputGestureText="Space" Click="Play_Click"/>
        <MenuItem Header="Stop" InputGestureText="Esc" Click="Stop_Click"/>
        <MenuItem Header="Crossfade Selected" Click="Crossfade_Click"/>
        <MenuItem Header="Toggle Fade In" Click="FadeIn_Click"/>
        <MenuItem Header="Toggle Fade Out" Click="FadeOut_Click"/>
      </MenuItem>
      <MenuItem Header="_Output">
        <MenuItem Header="Output Selected Display" Click="OutputSelected_Click"/>
        <MenuItem Header="Output All Displays" Click="OutputAll_Click"/>
        <MenuItem Header="Close All Outputs" Click="CloseOutputs_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Codecs" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom" Background="#1A1A1A" Foreground="#9A958D">
      <TextBlock x:Name="StatusClock" Text="00:00:00.000"/>
      <Separator/>
      <TextBlock x:Name="StatusCodec" Text="Media Foundation + DXVA · H.264 native · no WebM"/>
      <Separator/>
      <TextBlock x:Name="StatusLog" Text="Ready"/>
    </StatusBar>
    <ContentControl x:Name="Root"/>
  </DockPanel>
</Window>
