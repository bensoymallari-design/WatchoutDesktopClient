<Window x:Class="Watchout.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WatchMe"
        Width="1600" Height="980" MinWidth="1100" MinHeight="720"
        Background="#111111" Foreground="#E8E6E3"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#1A1A1A" Foreground="#E8E6E3">
      <MenuItem Header="_File">
        <MenuItem Header="_New Show" InputGestureText="Ctrl+Shift+N" Click="NewShow_Click"/>
        <MenuItem Header="Demo Show" Click="Demo_Click"/>
        <MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="Open_Click"/>
        <MenuItem Header="Import WATCHOUT 6…" Click="ImportWatchout6_Click"/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="Preferences…" Click="Prefs_Click"/>
        <Separator/>
        <MenuItem Header="Close Show" Click="QuitWelcome_Click"/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
        <Separator/>
        <MenuItem Header="_Delete" InputGestureText="Del" Click="Delete_Click"/>
        <MenuItem Header="Delete Asset" Click="DeleteAsset_Click"/>
        <MenuItem Header="Du_plicate" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
        <Separator/>
        <MenuItem x:Name="SnapItem" Header="Snap to Edges" IsCheckable="True" IsChecked="True" Click="Snap_Click"/>
        <MenuItem x:Name="ClickJumpItem" Header="Click Jumps Playhead" IsCheckable="True" IsChecked="True" Click="ClickJump_Click"/>
        <Separator/>
        <MenuItem x:Name="BlindItem" Header="Blind Edit" IsCheckable="True" Click="Blind_Click"/>
        <MenuItem Header="Take to Output" InputGestureText="Ctrl+T" Click="Take_Click"/>
      </MenuItem>
      <MenuItem Header="_Stage">
        <MenuItem Header="Frame _Wall in View" Click="Frame_Click"/>
        <MenuItem Header="Frame Selected Display" Click="FrameDisplayView_Click"/>
        <MenuItem Header="Fit Cue to _Display" Click="FitDisplay_Click"/>
        <MenuItem Header="Fit Cue to Wall" Click="FitWall_Click"/>
        <MenuItem Header="Add Display" Click="AddDisplay_Click"/>
        <MenuItem Header="Add Placeholder Cue" Click="Placeholder_Click"/>
        <MenuItem Header="_Edit Cues" Click="EditCues_Click"/>
        <MenuItem Header="Edit _Displays / Canvas" Click="EditDisplays_Click"/>
        <MenuItem Header="Display Grid 3×1" Click="Grid31_Click"/>
        <MenuItem Header="Display Grid 2×2" Click="Grid22_Click"/>
        <MenuItem Header="Display Grid 4×1" Click="Grid41_Click"/>
      </MenuItem>
      <MenuItem Header="_Timeline">
        <MenuItem Header="Play / Pause" InputGestureText="Space" Click="Play_Click"/>
        <MenuItem Header="Pause" Click="Pause_Click"/>
        <MenuItem Header="Stop" InputGestureText="Esc" Click="Stop_Click"/>
        <MenuItem x:Name="LoopItem" Header="Loop Play" IsCheckable="True" IsChecked="True" Click="Loop_Click"/>
        <MenuItem Header="Fit to Media" Click="FitMedia_Click"/>
        <Separator/>
        <MenuItem Header="Add Timeline" Click="AddTimeline_Click"/>
        <MenuItem Header="Delete Timeline" Click="DeleteTimeline_Click"/>
        <MenuItem Header="Add Layer" Click="AddLayer_Click"/>
        <MenuItem Header="Insert Layer" Click="InsertLayer_Click"/>
        <MenuItem Header="Delete Layer" Click="DeleteLayer_Click"/>
        <Separator/>
        <MenuItem Header="Crossfade Selected" Click="Crossfade_Click"/>
        <MenuItem Header="Toggle Fade In" Click="FadeIn_Click"/>
        <MenuItem Header="Toggle Fade Out" Click="FadeOut_Click"/>
      </MenuItem>
      <MenuItem Header="_Live">
        <MenuItem Header="Refresh NDI" Click="RefreshNdi_Click"/>
        <MenuItem Header="Import NDI to Assets" Click="ImportNdi_Click"/>
        <MenuItem Header="Place NDI on Layer" Click="ConnectNdi_Click"/>
        <MenuItem Header="Refresh Capture Cards" Click="RefreshCapture_Click"/>
        <MenuItem Header="Connect Capture Cards…" Click="ConnectCapture_Click"/>
        <MenuItem Header="Connect All Capture Cards" Click="ConnectAllCapture_Click"/>
        <Separator/>
        <MenuItem Header="Refresh NMOS" Click="RefreshNmos_Click"/>
        <MenuItem Header="Import ST 2110 SDP…" Click="ImportSdp_Click"/>
      </MenuItem>
      <MenuItem Header="_Assets">
        <MenuItem Header="Import Media…" Click="ImportMedia_Click"/>
        <MenuItem Header="Create H.264 Version" Click="CreateVersion_Click"/>
        <MenuItem Header="Re-optimize Selected" Click="CreateVersion_Click"/>
        <MenuItem Header="Encode HAP" Click="EncodeHap_Click"/>
        <Separator/>
        <MenuItem Header="Group Selected Cues" Click="Group_Click"/>
        <MenuItem Header="Ungroup Composition" Click="Ungroup_Click"/>
        <Separator/>
        <MenuItem Header="Watch Folder…" Click="WatchFolder_Click"/>
      </MenuItem>
      <MenuItem Header="_Output">
        <MenuItem Header="Output Selected Display" Click="OutputSelected_Click"/>
        <MenuItem Header="Output All Displays" Click="OutputAll_Click"/>
        <MenuItem Header="Close All Outputs" Click="CloseOutputs_Click"/>
        <Separator/>
        <MenuItem Header="Wake Display Node" Click="Wake_Click"/>
        <MenuItem Header="Ping Playback Node" Click="PingNode_Click"/>
        <MenuItem Header="Export LTC WAV…" Click="ExportLtc_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="What's New" Click="WhatsNew_Click"/>
        <MenuItem Header="User Guide (7.8 map)" Click="Guide_Click"/>
        <MenuItem Header="About WatchMe" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom" Background="#1A1A1A" Foreground="#9A958D">
      <TextBlock x:Name="StatusClock" Text="00:00:00.000"/>
      <Separator/>
      <TextBlock x:Name="StatusCodec" Text="Media Foundation + DXVA · H.264 native · no WebM"/>
      <Separator/>
      <TextBlock x:Name="StatusLog" Text="Ready"/>
    </StatusBar>
    <ContentControl x:Name="Root"/>
  </DockPanel>
</Window>
