<Application x:Class="Watchout.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Wo.Bg" Color="#111111"/>
    <SolidColorBrush x:Key="Wo.Panel" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Wo.Panel2" Color="#242424"/>
    <SolidColorBrush x:Key="Wo.Chrome" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Wo.Line" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Wo.Text" Color="#E8E6E3"/>
    <SolidColorBrush x:Key="Wo.Muted" Color="#9A958D"/>
    <SolidColorBrush x:Key="Wo.Amber" Color="#F5A623"/>
    <SolidColorBrush x:Key="Wo.Pink" Color="#E56DFF"/>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Wo.Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style TargetType="Menu">
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="Background" Value="#1A1A1A"/>
    </Style>
    <Style x:Key="Wo.Button" TargetType="Button">
      <Setter Property="Background" Value="#1F1F1F"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#F5A623"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Wo.Primary" TargetType="Button" BasedOn="{StaticResource Wo.Button}">
      <Setter Property="Background" Value="#F5A623"/>
      <Setter Property="Foreground" Value="#111"/>
      <Setter Property="BorderBrush" Value="#F5A623"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="BorderBrush" Value="#3F3F3F"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="CaretBrush" Value="#F5A623"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="BorderBrush" Value="#3F3F3F"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
    </Style>
    <Style TargetType="Label">
      <Setter Property="Foreground" Value="{StaticResource Wo.Muted}"/>
      <Setter Property="Padding" Value="0,0,0,2"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="Foreground" Value="{StaticResource Wo.Text}"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="12"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
