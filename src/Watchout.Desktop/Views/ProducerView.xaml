<UserControl x:Class="Watchout.Desktop.Views.ProducerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Watchout.Desktop.Views">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1.15*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.4*"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="0.7*"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Row="0" Grid.Column="0" Background="#1C1C1C">
      <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4" BorderBrush="#111" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="ZoomIn_Click" Content="+"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="ZoomOut_Click" Content="−"/>
            <Button x:Name="FitWallBtn" Style="{StaticResource Wo.Button}" Padding="8,2" Click="FrameWall_Click" Content="Fit wall"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="FrameDisplay_Click" Content="Fit display"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="EditCuesBtn" Style="{StaticResource Wo.Button}" Padding="8,2" Click="EditCues_Click" Content="Edit cues"/>
            <Button x:Name="EditDisplaysBtn" Style="{StaticResource Wo.Button}" Padding="8,2" Click="EditDisplays_Click" Content="Edit displays"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="Output_Click" Content="Output"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="OutputAll_Click" Content="Output all"/>
          </StackPanel>
          <TextBlock x:Name="StageHint" Text="Stage  ·  Fit wall centers the layout · drag empty Stage to pan" Foreground="#FFE8B0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
      <views:StageSurface x:Name="Stage" Editing="True" PlayAudio="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </DockPanel>
    <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#111"/>

    <DockPanel Grid.Row="0" Grid.Column="2" Background="#1C1C1C">
      <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4">
        <TextBlock Text="Properties" Foreground="#D6D3D1"/>
      </Border>
      <views:PropertiesPanel x:Name="Properties"/>
    </DockPanel>
    <GridSplitter Grid.Row="0" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="#111"/>

    <Grid Grid.Row="0" Grid.Column="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="6"/>
        <RowDefinition Height="0.55*"/>
      </Grid.RowDefinitions>
      <DockPanel Background="#1C1C1C">
        <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource Wo.Go}" Padding="8,2" Margin="0,0,8,0" Click="Ndi_Click" Content="NDI"/>
              <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="Import_Click" Content="Import"/>
              <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="DeleteAsset_Click" Content="Delete"/>
            </StackPanel>
            <TextBlock Text="Assets" Foreground="#D6D3D1" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <views:AssetsPanel x:Name="Assets"/>
      </DockPanel>
      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#111"/>
      <DockPanel Grid.Row="2" Background="#1C1C1C">
        <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4">
          <TextBlock Text="Timelines" Foreground="#D6D3D1"/>
        </Border>
        <views:TimelinesPanel x:Name="Timelines"/>
      </DockPanel>
    </Grid>

    <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="6" HorizontalAlignment="Stretch" Background="#111"/>

    <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#1C1C1C">
      <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="8,4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <CheckBox x:Name="LoopBox" Content="Loop" VerticalAlignment="Center" Margin="0,0,12,0" Click="Loop_Click"/>
            <Button x:Name="FitMediaBtn" Style="{StaticResource Wo.Button}" Padding="8,2" Margin="0,0,8,0" Click="FitMedia_Click" Content="Fit to media"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="Play_Click" Content="Play"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="Pause_Click" Content="Pause"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="Stop_Click" Content="Stop"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="AddLayer_Click" Content="Add layer"/>
            <Button Style="{StaticResource Wo.Button}" Padding="8,2" Click="DeleteLayer_Click" Content="Delete layer"/>
          </StackPanel>
          <TextBlock x:Name="TimelineTitle" Text="Timeline" Foreground="#D6D3D1" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <views:TimelinePanel x:Name="Timeline" Grid.Row="0" Grid.Column="0"
                             ToolTip="Wheel scrolls time · Shift+wheel scrolls layers · Ctrl+wheel zooms · middle-drag pans · click the eye or lock on a layer"/>
        <ScrollBar x:Name="TimelineVScroll" Grid.Row="0" Grid.Column="1" Orientation="Vertical" Width="12"
                   Minimum="0" SmallChange="28" Scroll="TimelineVScroll_Scroll"/>
        <ScrollBar x:Name="TimelineHScroll" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Height="12" Width="Auto"
                   HorizontalAlignment="Stretch" Minimum="0" Scroll="TimelineHScroll_Scroll"/>
        <Rectangle Grid.Row="1" Grid.Column="1" Fill="#161616" Width="12" Height="12"/>
      </Grid>
    </DockPanel>

    <TabControl x:Name="StudioBottom" Grid.Row="2" Grid.Column="4" Background="#1C1C1C" BorderBrush="#111" Foreground="#E8E6E3" SelectedIndex="0">
      <TabItem Header="Devices">
        <views:DevicesPanel x:Name="Devices"/>
      </TabItem>
      <TabItem Header="Layers">
        <views:LayersPanel x:Name="Layers"/>
      </TabItem>
      <TabItem Header="Log">
        <views:LogPanel x:Name="Log"/>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
